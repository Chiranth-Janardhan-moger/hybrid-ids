# Hybrid IDS Environment Configuration Template
# Copy this file to .env and adjust variables as required:
#   cp .env.example .env

# Server HTTP Port (default: 3000)
PORT=3000

# Node Environment ('production' or 'development')
NODE_ENV=production

# Administrative API Key for protected endpoints (/api/ips/toggle, /api/engine-config, /api/alerts/:id/triage)
ADMIN_API_KEY=hybrid-ids-admin-secret

# Path to SQLite database file
HYBRID_IDS_DB=./data/hybrid_ids.db

# Path to Python 3 binary (automatically set to /opt/venv/bin/python3 inside Docker)
PYTHON_BIN=python3

# Optional: Gemini API Key for AI copilot queries
GEMINI_API_KEY=

# Optional: Failure simulation flags for Scenario D testing (0 = normal, 1 = simulate failure)
SURICATA_UNAVAILABLE=0
ML_MODEL_MISSING=0
